DirectoryIndex index.php
Options -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self' data: https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
RewriteEngine On
# Keep the canonical HTTPS redirect already configured on IONOS.
RewriteCond %{SERVER_PORT} !=443 [OR]
RewriteCond %{HTTP_HOST} !^delir\.it$ [NC]
RewriteRule ^ https://delir.it%{REQUEST_URI} [R=301,L]
RewriteRule ^(pilot|security-data|comparison-sources|privacy|waitlist|v2)/$ /$1 [R=301,L]

# Root and application routes use pre-rendered HTML selected by language.
RewriteRule ^$ index.php [END]
RewriteRule ^(pilot|security-data|comparison-sources|privacy|waitlist|v2)/?$ index.php [END]

# Existing assets and API files must keep their original handlers.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [END]

# Unknown paths get an actual HTTP 404, rather than a soft-404 SPA response.
RewriteRule ^ index.php [END]
