{
  "name": "delir-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000",
    "build": "vite build --configLoader runner && node scripts/prerender.mjs",
    "preview": "vite preview --configLoader runner --host 127.0.0.1 --port 4173",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\"",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest --configLoader runner run",
    "test:coverage": "vitest --configLoader runner run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:responsive": "playwright test e2e/responsive.spec.ts",
    "test:smoke": "playwright test e2e/production-smoke.spec.ts --project=chromium",
    "test:lighthouse": "node scripts/lighthouse.mjs lighthouserc.json",
    "quality": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "cf:deploy:staging": "npm run build && wrangler deploy --env staging",
    "test:lighthouse:mobile": "node scripts/lighthouse.mjs lighthouserc.mobile.json"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.54.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.3",
    "vite-imagetools": "^9.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "sharp@0.35.5": true
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
