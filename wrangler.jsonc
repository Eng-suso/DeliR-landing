{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delir-landing",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // PR builds upload a version with its own preview URL instead of going live.
  "preview_urls": true,
  "env": {
    // Deployed as the separate Worker "delir-landing-staging" (own *.workers.dev URL).
    "staging": {
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}
