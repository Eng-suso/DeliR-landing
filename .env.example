# Lead capture stays closed unless all four values are configured and verified.
# Endpoints must be server-side intake routes. Never put a CRM secret or private webhook in VITE_*.
# A cross-origin URL must also be added to connect-src in public/_headers.
VITE_LEAD_CAPTURE_READY=false
VITE_PRIVACY_NOTICE_URL=
VITE_WAITLIST_ENDPOINT=
VITE_PILOT_ENDPOINT=
