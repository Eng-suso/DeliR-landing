# Lead capture stays closed unless all four values are configured and verified.
# Endpoints must be server-side intake routes. Never put a CRM secret or private webhook in VITE_*.
# A cross-origin URL must also be added to connect-src in public/_headers.
VITE_LEAD_CAPTURE_READY=true
VITE_PRIVACY_NOTICE_URL=/privacy
VITE_WAITLIST_ENDPOINT=
# Independent switch: enable only after installing/verifying /api/waitlist.php.
VITE_WAITLIST_READY=false
VITE_PILOT_ENDPOINT=/api/pilot.php
# IONOS, only after deployment/privacy/real-write verification: /api/pilot.php
# Private database settings stay outside /public; see docs/ionos-pilot-backend.md.

# Public measurement ID, not a credential. The IONOS-only notice is ready.
# Keep analytics closed until the notice covers Google, property settings and terms are verified.
VITE_GA_MEASUREMENT_ID=G-6D2FN0HCDS
VITE_PRIVACY_NOTICE_READY=true
VITE_ANALYTICS_READY=false
